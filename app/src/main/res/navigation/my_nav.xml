<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/my_nav"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.bookclub.ui.fragment.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_bookListFragment"
            app:destination="@id/bookListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/bookListFragment"
        android:name="com.example.bookclub.ui.fragment.BookListFragment"
        android:label="Book List">
        <action
            android:id="@+id/action_bookListFragment_to_bookDetailFragment"
            app:destination="@id/bookDetailFragment" />
        <action
            android:id="@+id/action_bookListFragment_to_statisticsFragment"
            app:destination="@id/statisticsFragment" />
        <action
            android:id="@+id/action_bookListFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment" />
        <action
            android:id="@+id/action_bookListFragment_to_bookEditFragment"
            app:destination="@id/bookEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookDetailFragment"
        android:name="com.example.bookclub.ui.fragment.BookDetailFragment"
        android:label="Book Details">
        <argument
            android:name="bookId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.example.bookclub.ui.fragment.StatisticsFragment"
        android:label="Statistics" />

    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.example.bookclub.ui.fragment.UserProfileFragment"
        android:label="User Profile">
        <action
            android:id="@+id/action_userProfileFragment_to_bookEditFragment"
            app:destination="@id/bookEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookEditFragment"
        android:name="com.example.bookclub.ui.fragment.BookEditFragment"
        android:label="Edit Book">
        <argument
            android:name="bookId"
            app:argType="integer"
            android:defaultValue="-1" />
        <action
            android:id="@+id/action_bookEditFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment" />
    </fragment>

    <!-- Global logout action -->
    <action
        android:id="@+id/action_global_logout_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/bookListFragment"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_to_userProfileFragment"
        app:destination="@id/userProfileFragment" />

    <action
        android:id="@+id/action_global_to_statisticsFragment"
        app:destination="@id/statisticsFragment" />

    <action
        android:id="@+id/action_global_to_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/bookListFragment"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_to_bookListFragment"
        app:destination="@id/bookListFragment"
        app:popUpTo="@id/loginFragment"
        app:popUpToInclusive="true" />


</navigation>


